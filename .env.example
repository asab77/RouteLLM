# Public Docker development credentials only; never use for deployed databases.
# FastAPI/Python run on macOS; PostgreSQL runs in Docker on loopback port 5432.
DATABASE_URL=postgresql+asyncpg://routellm:local_dev_only@127.0.0.1:5432/routellm
TEST_DATABASE_URL=postgresql+asyncpg://routellm_test:local_test_only@127.0.0.1:5432/routellm_test
TELEMETRY_TIMEOUT_SECONDS=2
