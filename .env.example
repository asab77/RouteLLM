# Public Docker development credentials only; never use for deployed databases.
# FastAPI/Python run on macOS; PostgreSQL runs in Docker on loopback port 5432.
DATABASE_URL=postgresql+asyncpg://routellm:local_dev_only@127.0.0.1:5432/routellm
TEST_DATABASE_URL=postgresql+asyncpg://routellm_test:local_test_only@127.0.0.1:5432/routellm_test
TELEMETRY_TIMEOUT_SECONDS=2

# Vercel gateway key belongs only in ignored .env; blank keeps offline mode.
AI_GATEWAY_API_KEY=
AI_GATEWAY_TIMEOUT_SECONDS=60
# Root for controlled benchmark/evaluation artifacts; API accepts UUIDs, not paths.
BENCHMARK_RESULTS_DIR=benchmark-results

# Optional adaptive HTTP mode. Leave both blank to disable it. When enabled,
# supply a trusted local Phase 8C artifact directory and unique registry model IDs.
ROUTELLM_ADAPTIVE_ARTIFACT_PATH=
ROUTELLM_ADAPTIVE_CANDIDATES=
